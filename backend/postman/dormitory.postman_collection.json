{
  "info": {
    "name": "Hệ thống quản lý ký túc xá",
    "description": "Chạy bằng Collection Runner (thứ tự từ trên xuống). Cần seed dữ liệu mẫu và API đang chạy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Hệ thống",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trả về là 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"CSDL hoạt động\", () => pm.expect(pm.response.json().database).to.eql(\"up\"));",
                  "pm.test(\"Có header bảo mật\", () => { pm.response.to.have.header(\"X-Content-Type-Options\"); pm.response.to.have.header(\"X-Frame-Options\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            }
          ]
        }
      ]
    },
