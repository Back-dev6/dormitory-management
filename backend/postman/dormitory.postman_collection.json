    {
      "name": "4. Điện nước và hóa đơn",
      "item": [
        {
          "name": "Cán bộ tạo phòng thử",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mgrToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\"building_id\":{{buildingId}},\"room_number\":\"PM{{runId}}\",\"floor\":9,\"max_beds\":2,\"price_per_bed\":\"100000\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trả về là 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"newRoomId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ghi chỉ số tháng hiện tại (tự sinh hóa đơn)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mgrToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/utilities/readings",
            "body": {
              "mode": "raw",
              "raw": "{\"room_id\":{{newRoomId}},\"month\":{{month}},\"year\":{{year}},\"electric_new\":120,\"water_new\":8,\"electric_old\":0,\"water_old\":0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trả về là 201\", () => pm.response.to.have.status(201));",
                  "const inv = pm.response.json().invoice;",
                  "pm.test(\"Số điện, nước đúng\", () => { pm.expect(inv.electric_usage).to.eql(120); pm.expect(inv.water_usage).to.eql(8); });",
                  "pm.test(\"Tổng = phòng + điện + nước\", () => pm.expect(parseFloat(inv.total)).to.eql(parseFloat(inv.room_fee) + parseFloat(inv.electric_amount) + parseFloat(inv.water_amount)));",
                  "pm.test(\"Chưa thanh toán\", () => pm.expect(inv.status).to.eql(\"UNPAID\"));",
                  "pm.collectionVariables.set(\"invoiceId\", inv.id);"
                ]
              }
