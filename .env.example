# Sao chép thành file ".env" (cùng thư mục với docker-compose.yml) rồi sửa giá trị.
# File .env KHÔNG được commit.

POSTGRES_USER=dorm_user
# Chỉ dùng chữ và số (ký tự như @ : / làm hỏng chuỗi kết nối). Tạo bằng:
#   python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=DOI_MAT_KHAU_NAY
POSTGRES_DB=dorm_db

# Khóa ký JWT, tối thiểu 32 ký tự. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=DOI_KHOA_NAY_DAI_IT_NHAT_32_KY_TU

# Địa chỉ mà trình duyệt dùng để mở web (cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:8080

# Cổng mở ra máy chủ cho web (VPS: đặt 80)
WEB_PORT=8080

# true = nạp dữ liệu mẫu (tài khoản demo có mật khẩu yếu, CHỈ dùng để demo/bảo vệ đồ án)
SEED_DEMO_DATA=true
